<mujoco model="metamophic">
  <compiler angle="radian"/>

  <option gravity="0 0 0"/>

  <default>
    <joint damping="0.03"/>
    <geom friction="2"/>
    <default class="robot">
      <joint damping="0"/>
      <geom friction="1"/>
      <default class="motor">
        <joint limited="false" frictionloss="0.5"/>
        <general ctrlrange="-4 4" biastype="affine" gainprm="30" biasprm="0 -30 -0.2"/>
      </default>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" material="visualgeom"/>
      </default>
      <default class="collision">
        <geom contype="0" group="1" priority="1" friction="1 0.01 0.01" solref="0.005" solimp="0.99 0.999 1e-05" material="collision_material"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="default_material" rgba="0.66667 0.69804 0.76863 1"/>
    <material name="default_material1" rgba="0.7 0.7 0.7 1"/>
    <material name="collision_material" rgba="1 0.28 0.1 0.9"/>
    <mesh name="base1.STL" file="meshes/base1.STL"/>
    <mesh name="base2.STL" file="meshes/base2.STL"/>

<mujoco model="BallDropHf">
  <asset>
    <!-- HeightField terrain: same 257x257 PNG used by the Sire simulation -->
    <hfield name="terrain"
            file="D:\code\sire\demo\demo_python\heightField\terrain_hf.png"
            size="5 5 0.2 0.001"/>
    <material name="terrain_mat" rgba="0.45 0.55 0.40 1" reflectance="0.08"/>
    <material name="ball_mat" rgba="0.90 0.15 0.10 1" reflectance="0.30"/>
  </asset>

  <default>
    <!-- Stiff contacts approximating Sire's k=2.8e8, d=2000 -->
    <geom solref="0.0005 1.0" solimp="0.95 0.98 0.001" friction="0.6 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="5 5 8" dir="0 0 -1" directional="true"/>
    <light pos="-3 8 6" dir="-0.3 0 -1" directional="true"/>
    <!-- Terrain centered at (7,7,0), 10×10 m extent -->
    <geom type="hfield" name="ground" hfield="terrain" pos="7 7 0" material="terrain_mat"/>
    <!-- Ball: same initial pos (7,7,0.5), radius=0.05, mass=1 -->
    <body name="ball" pos="7 7 0.5">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.05" material="ball_mat" mass="1"/>
    </body>
  </worldbody>

  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" tolerance="1e-10">
    <flag contact="enable" energy="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    <global azimuth="135" elevation="-30"/>
  </visual>
</mujoco>

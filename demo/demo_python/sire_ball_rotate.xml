		<MotionPoolElement __prop_name__="motion_pool"/>
		<JointPoolElement __prop_name__="joint_pool"/>
		<GeneralMotionPoolElement __prop_name__="general_motion_pool"/>
		<ForcePoolElement __prop_name__="force_pool"/>
